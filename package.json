{
  "name": "ai-asset-hub",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/check-dev-port.mjs",
    "dev": "tauri dev -- --locked",
    "dev:web": "vite",
    "test": "node --test && npm run test:core",
    "test:core": "node scripts/run-python-checks.mjs",
    "check": "npm test && npm run build",
    "typecheck": "vue-tsc --noEmit && tsc --project tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:installer": "tauri build --bundles nsis -- --locked",
    "package:core": "node scripts/package-core.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.7",
    "jsdom": "^28.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
